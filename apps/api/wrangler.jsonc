{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "start-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "start-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "start-storage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "start-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "start-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  }
}
